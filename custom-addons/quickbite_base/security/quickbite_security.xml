<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_quickbite" model="res.groups.privilege">
        <field name="name">QuickBite</field>
        <field name="category_id" ref="base.module_category_sales"/>
        <field name="sequence">30</field>
    </record>

    <record id="group_quickbite_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="comment">Day-to-day restaurant operations (read configuration).</field>
        <field name="privilege_id" ref="res_groups_privilege_quickbite"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_quickbite_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="comment">Full access, including outlet configuration.</field>
        <field name="privilege_id" ref="res_groups_privilege_quickbite"/>
        <field name="implied_ids" eval="[(4, ref('group_quickbite_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_quickbite_outlet_company" model="ir.rule">
        <field name="name">QuickBite outlet: multi-company</field>
        <field name="model_id" ref="model_quickbite_outlet"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
