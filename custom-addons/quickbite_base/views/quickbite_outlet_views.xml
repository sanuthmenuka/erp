<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quickbite_outlet_view_list" model="ir.ui.view">
        <field name="name">quickbite.outlet.list</field>
        <field name="model">quickbite.outlet</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="city"/>
                <field name="currency_id" optional="hide"/>
                <field name="service_charge_pct" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="quickbite_outlet_view_form" model="ir.ui.view">
        <field name="name">quickbite.outlet.form</field>
        <field name="model">quickbite.outlet</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Colombo 07"/></h1>
                    </div>
                    <group>
                        <group string="Location">
                            <field name="code"/>
                            <field name="address"/>
                            <field name="city"/>
                            <field name="country_id"/>
                            <field name="tz"/>
                        </group>
                        <group string="Defaults">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                            <field name="lang"/>
                            <field name="service_charge_pct"/>
                            <field name="packaging_charge_default"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Order Types" name="order_types">
                            <field name="setting_ids">
                                <list editable="bottom">
                                    <field name="order_type"/>
                                    <field name="is_enabled"/>
                                    <field name="tax_inclusive"/>
                                    <field name="service_charge_pct"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="packaging_charge"/>
                                    <field name="default_payment_window_seconds"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="quickbite_outlet_view_search" model="ir.ui.view">
        <field name="name">quickbite.outlet.search</field>
        <field name="model">quickbite.outlet</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="city"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="quickbite_outlet_action" model="ir.actions.act_window">
        <field name="name">Outlets</field>
        <field name="res_model">quickbite.outlet</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first outlet</p>
        </field>
    </record>
</odoo>
