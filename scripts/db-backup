#!/bin/bash
# Snapshot the database + filestore so any change can be rolled back.
# Usage: db-backup [label]          -> db/backups/<timestamp>-<label>/
# Contents: odoo.dump (pg_dump -Fc), filestore.tar.gz, installed_modules.txt, meta.txt
source "$(dirname "$0")/_lib.sh"

LABEL="${1:-manual}"
LABEL="$(echo "$LABEL" | tr -c 'A-Za-z0-9_.-' '-' | sed 's/-*$//')"
DIR="$BACKUP_ROOT/$(date +%Y%m%d-%H%M%S)-$LABEL"

db_exists "$DB_NAME" || { echo "error: database '$DB_NAME' does not exist" >&2; exit 1; }

SERVER_MAJOR="$(psql -d postgres -tAc 'SHOW server_version_num' | cut -c1-2)"
CLIENT_MAJOR="$(pg_dump --version | grep -oE '[0-9]+' | head -1)"
if [ "$CLIENT_MAJOR" -lt "$SERVER_MAJOR" ]; then
    echo "error: pg_dump $CLIENT_MAJOR is older than server $SERVER_MAJOR. Rebuild the devcontainer" >&2
    echo "       (Dockerfile installs postgresql-client-$SERVER_MAJOR)." >&2
    exit 1
fi

mkdir -p "$DIR"
echo "Backing up '$DB_NAME' -> $DIR"
pg_dump -Fc -f "$DIR/odoo.dump" "$DB_NAME"

if [ -d "$DATA_DIR/filestore/$DB_NAME" ]; then
    tar -C "$DATA_DIR/filestore" -czf "$DIR/filestore.tar.gz" "$DB_NAME"
else
    echo "  (no filestore at $DATA_DIR/filestore/$DB_NAME)"
fi

psql -d "$DB_NAME" -tAc "SELECT name || ' ' || coalesce(latest_version,'') FROM ir_module_module WHERE state='installed' ORDER BY name" > "$DIR/installed_modules.txt"

cat > "$DIR/meta.txt" <<META
db=$DB_NAME
label=$LABEL
created=$(date -Iseconds)
git=$(git_rev) ($(git_dirty))
odoo_core=$(git -C "$WORKSPACE/odoo" rev-parse --short HEAD 2>/dev/null || echo unknown)
META

echo "Done: $(du -sh "$DIR" | cut -f1)  git=$(git_rev) ($(git_dirty))"
echo "$DIR"
