#!/bin/bash
# Start the Odoo dev server. Initialises the DB with `base` on first run.
# Extra args are passed to odoo-bin, e.g. `odoo-start --dev=all`.
source "$(dirname "$0")/_lib.sh"

if db_initialized "$DB_NAME"; then
    odoo -d "$DB_NAME" "$@"
else
    echo "Database '$DB_NAME' not initialised. Installing base..."
    odoo -d "$DB_NAME" -i base "$@"
fi
