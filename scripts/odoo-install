#!/bin/bash
# Install module(s) into the dev DB. Snapshots the DB first.
# Usage: odoo-install mod1[,mod2] [extra odoo-bin args]
source "$(dirname "$0")/_lib.sh"
MODS="${1:?usage: odoo-install mod1[,mod2]}"; shift
warn_if_server_running
"$(dirname "$0")/db-backup" "pre-install-${MODS//,/+}"
odoo -d "$DB_NAME" -i "$MODS" --stop-after-init --no-http "$@"
echo "Installed $MODS. Restart the server (odoo-start)."
